# Copy to .env; configuration is read from this file, without shell exports.
# Incoming API access is managed in Admin > Configuration > Assistant API access.
# AI usage limits are managed in Admin > Configuration > AI usage limits.
# Its token hash and visitor signing secret are stored in ignored runtime data,
# separately from the outgoing generation/embedding provider credentials below.
WEBSITE_ASSISTANT_HOST=127.0.0.1
WEBSITE_ASSISTANT_PORT=8001
WEBSITE_ASSISTANT_DATA_PATH=data
WEBSITE_ASSISTANT_NAME=Website Assistant
# Reserved for the earlier ingestion API; enter the URL in Website Integration.
WEBSITE_ASSISTANT_HOME_URL=
# No default administrator. Generate a hash with:
# python -m site_runtime.admin_auth
WEBSITE_ASSISTANT_ADMIN_USERNAME=
WEBSITE_ASSISTANT_ADMIN_PASSWORD_HASH=''
WEBSITE_ASSISTANT_ADMIN_ROLE=administrator
WEBSITE_ASSISTANT_ADMIN_SESSION_MINUTES=30
# false is only for local HTTP; use true when serving through HTTPS.
WEBSITE_ASSISTANT_ADMIN_COOKIE_SECURE=false
# Optional complete chat-completions endpoint. Leave all three blank for excerpts.
WEBSITE_ASSISTANT_AI_API_ENDPOINT=
WEBSITE_ASSISTANT_AI_API_KEY=''
WEBSITE_ASSISTANT_AI_MODEL=
WEBSITE_ASSISTANT_AI_TIMEOUT_SECONDS=30
WEBSITE_ASSISTANT_CHAT_RATE_LIMIT=60
# Shared by every local worker and persisted across restarts.
WEBSITE_ASSISTANT_RATE_LIMIT_DB=data/rate_limits.db
# Activate valid completed builds; large coverage drops stay staged for review.
WEBSITE_ASSISTANT_AUTO_ACTIVATE=true
WEBSITE_ASSISTANT_MAX_SOURCE_DROP_FRACTION=0.30

WEBSITE_ASSISTANT_INTENT_CLASSIFIER_ENABLED=false
WEBSITE_ASSISTANT_EMBEDDING_ENDPOINT=
WEBSITE_ASSISTANT_EMBEDDING_API_KEY=
WEBSITE_ASSISTANT_EMBEDDING_MODEL=
WEBSITE_ASSISTANT_EMBEDDING_TIMEOUT_SECONDS=15
WEBSITE_ASSISTANT_APPOINTMENT_RATE_LIMIT=30
WEBSITE_ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=60
WEBSITE_ASSISTANT_APPOINTMENT_DB=data/appointments.db
WEBSITE_ASSISTANT_ADMIN_SESSION_DB=data/admin_sessions.db
WEBSITE_ASSISTANT_SECURITY_AUDIT_DB=data/security_audit.db
WEBSITE_ASSISTANT_AUDIT_RETENTION_DAYS=90
WEBSITE_ASSISTANT_AUDIT_MAX_RECORDS=10000
